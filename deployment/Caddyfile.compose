# Development/test container configuration only.
{
    # IP clients normally omit SNI. Select the single configured certificate.
    default_sni {$DOMAIN}
}

{$DOMAIN} {
    # Explicit public issuer: never fall back to Caddy's local CA for an IP.
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    encode gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        -Server
    }
    @https protocol https
    header @https Strict-Transport-Security "max-age=31536000"

    @ozonDenied {
        path /api/ozon/webhook
        not remote_ip 195.34.21.0/24 185.73.192.0/22 91.223.93.0/24
    }
    # Preserve security-filter order ahead of the broader API path matcher.
    route {
        handle @ozonDenied {
            header Content-Type application/json
            respond `{"error":{"code":"ERROR_UNKNOWN","message":"Source is not allowed","details":null}}` 403
        }

        handle /api/* {
            request_body {
                max_size 21MB
            }
            reverse_proxy backend:8000 {
                header_up X-Ozon-Source-IP {remote_host}
                # Immediate flush for SSE; WebSocket upgrades are supported natively.
                flush_interval -1
            }
        }

        handle {
            root * /srv
            try_files {path} /index.html
            file_server
        }
    }
}
