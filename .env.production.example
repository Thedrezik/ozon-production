# Generate /etc/ozon-production/production.env as root, mode 600; never source it.
# Use scripts/init-production-env.py; no secrets are required at frontend build time.
APP_ENV=production
OZON_MOCK_MODE=false
# Public IPv4 (preferred) or actual DNS hostname; no scheme/path/port.
DOMAIN=
APP_PUBLIC_URL=
APP_SECRET=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
OZON_CREDENTIALS_MASTER_KEY=
OZON_WEBHOOK_TRUSTED_PROXIES=127.0.0.1/32
ORGANIZATION_TIMEZONE=Europe/Moscow
MONEY_RISK_NEAR_HOURS=2
MONEY_RISK_CUTOFF_HOURS=12,16
UPLOAD_DIR=/var/lib/ozon-production/uploads
BACKUP_DIR=/var/lib/ozon-production/backups
UPLOAD_MAX_BYTES=10485760
# Save Client ID/Api-Key in Admin → Ozon after startup (encrypted DB storage).
# Register and verify webhook in Ozon Seller; reconciliation survives failure.
OZON_WEBHOOK_ENABLED=true
OZON_RECONCILIATION_ENABLED=true
OZON_RECONCILIATION_INTERVAL_SECONDS=900
OZON_RECONCILIATION_LOOKBACK_DAYS=30
OZON_STALE_AFTER_SECONDS=1800
OZON_TIMEOUT_SECONDS=10
OZON_MAX_RETRIES=2
OZON_RETRY_BACKOFF_SECONDS=1
OZON_RETRY_MAX_DELAY_SECONDS=30
OZON_KEY_ALERT_DAYS=14,7,3,1
# Web Push is optional. Configure all Telegram values for core admin alerts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# All extended features off; comma-separated names from docs/OPTIONAL_FEATURES.md.
ENABLED_OPTIONAL_FEATURES=
