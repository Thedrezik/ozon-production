# Copy to .env.production, chmod 600. No usable secrets/default domain.
# Use scripts/init-production-env.py for generated secrets after subnet review.
APP_ENV=production
OZON_MOCK_MODE=false
DOMAIN=
APP_PUBLIC_URL=
APP_SECRET=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
OZON_CREDENTIALS_MASTER_KEY=
# Immutable release tags/digests; same release for both application images.
BACKEND_IMAGE=
CADDY_IMAGE=
# Review ip route and Docker networks first. Exact IPv4 Caddy address in proxy subnet.
PROXY_SUBNET=
DATABASE_SUBNET=
CADDY_PROXY_IP=
OZON_WEBHOOK_TRUSTED_PROXIES=
ORGANIZATION_TIMEZONE=Europe/Moscow
MONEY_RISK_NEAR_HOURS=2
MONEY_RISK_CUTOFF_HOURS=12,16
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
UPLOAD_MAX_BYTES=10485760
# Enable only after real credential validation/import and Ozon connection check.
OZON_WEBHOOK_ENABLED=false
OZON_RECONCILIATION_ENABLED=false
OZON_RECONCILIATION_INTERVAL_SECONDS=240
OZON_RECONCILIATION_LOOKBACK_DAYS=30
OZON_STALE_AFTER_SECONDS=600
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_TIMEOUT_SECONDS=10
OZON_MAX_RETRIES=2
OZON_RETRY_BACKOFF_SECONDS=1
OZON_RETRY_MAX_DELAY_SECONDS=30
OZON_KEY_ALERT_DAYS=14,7,3,1
# Optional: set all values in each group or leave the entire group blank.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
