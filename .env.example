APP_ENV=development
# Production: APP_ENV=production, OZON_MOCK_MODE=false, DOMAIN=<real domain>,
# APP_PUBLIC_URL=https://<same domain>; random APP_SECRET (32+ chars),
# POSTGRES_PASSWORD (16+ chars) and a valid Fernet master key are mandatory.
# Startup rejects development credentials, mock mode and incomplete integrations.
APP_SECRET=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://ozon:replace-with-a-strong-password@postgres:5432/ozon
DOMAIN=:80
ORGANIZATION_TIMEZONE=Europe/Moscow
OZON_MOCK_MODE=true
# Apply migration 0018 before enabling. One API process owns the scheduler.
OZON_RECONCILIATION_ENABLED=true
OZON_RECONCILIATION_INTERVAL_SECONDS=900
OZON_RECONCILIATION_LOOKBACK_DAYS=30
OZON_STALE_AFTER_SECONDS=1800
# Enable only after applying migration 0017. Behind Caddy, specify its actual
# Docker peer IP (/32 or /128 required in production); forwarded headers are rejected.
OZON_WEBHOOK_ENABLED=true
OZON_WEBHOOK_TRUSTED_PROXIES=
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_TIMEOUT_SECONDS=10
OZON_MAX_RETRIES=2
OZON_RETRY_BACKOFF_SECONDS=1
OZON_RETRY_MAX_DELAY_SECONDS=30
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups

# Optional Web Push: generate once with python -m app.push_keys (from backend).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Core Telegram alerts to linked administrators. Configure the Telegram webhook URL as
# https://<domain>/api/telegram/webhook with this secret token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
APP_PUBLIC_URL=https://example.com

# Fernet key, backend only; retain securely alongside backups. Never rotate without re-encryption.
OZON_CREDENTIALS_MASTER_KEY=
OZON_KEY_ALERT_DAYS=14,7,3,1
UPLOAD_MAX_BYTES=10485760

# All extended features off; comma-separated names from docs/OPTIONAL_FEATURES.md.
ENABLED_OPTIONAL_FEATURES=
